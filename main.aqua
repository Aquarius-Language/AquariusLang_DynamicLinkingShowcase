var library = import("Showcase");
print(library.Greeting());
print("繁體中文 UTF-8:", library.Echo("你好，星泉！"));
print("English UTF-8:", library.Echo("Hello, Aquarius!"));
print("10 + 20 + 12 =", library.Sum([10, 20, 12]));
if (library.Sum([10, 20, 12]) != 42 || library.Echo("星泉") != "星泉") { return 1; }
print("DYNAMIC_LINKING_OK / 動態連結成功");
